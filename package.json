{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "1:1 and group chat backend - Postgres for users/chats, Firestore for messages and read receipts",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/cli/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "firebase emulators:exec --only firestore --project demo-chat-backend \"vitest run\"",
    "test:only": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "firebase-tools": "^15.37.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
